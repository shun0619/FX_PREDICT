# OANDA を使う場合のみ設定 (ペーパー口座だけなら不要)
# このファイルを .env にコピーして値を入れる。.env は .gitignore 済み。
#
# トークンは OANDA の管理画面「APIアクセス管理」で発行する。
# 実口座のトークンは絶対に共有・コミットしないこと。

OANDA_TOKEN=your-token-here
OANDA_ACCOUNT_ID=101-009-0000000-001

# practice = デモ口座 / live = 本番口座
OANDA_ENV=practice

# 本番口座を使うときだけ 1 にする (未設定なら live を選んでも拒否される)
# FX_ALLOW_LIVE=0

# 特徴量セットの切り替え (full / no_macro / lean_sr / lean_ichi / lean / core)
# FX_FEATURE_SET=full
